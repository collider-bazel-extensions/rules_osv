#!/usr/bin/env bash
# rules_osv test wrapper: resolves the driver, runs it on runfiles.
# Substitution markers use __KEY__ syntax to avoid colliding with bash.
set -euo pipefail

if [[ -z "${RUNFILES_DIR:-}" ]]; then
  if [[ -n "${TEST_SRCDIR:-}" ]]; then RUNFILES_DIR="$TEST_SRCDIR"
  elif [[ -d "${0}.runfiles" ]]; then RUNFILES_DIR="${0}.runfiles"
  fi
  : "${RUNFILES_DIR:?rules_osv: no runfiles found; run it with bazel test}"
  export RUNFILES_DIR
fi

rel="__DRIVER__"
case "$rel" in
  ../*) driver="${RUNFILES_DIR}/${rel#../}" ;;
  *) driver="${RUNFILES_DIR}/_main/${rel}" ;;
esac
[[ -e "$driver" ]] || { echo "rules_osv: not in runfiles: __DRIVER__" >&2; exit 1; }

out="${TEST_UNDECLARED_OUTPUTS_DIR:-${TEST_TMPDIR:-${TMPDIR:-/tmp}}}"
reports=(--json "$out/osv-scanner.json")
if [[ -n "${XML_OUTPUT_FILE:-}" ]]; then reports+=(--junit "$XML_OUTPUT_FILE"); fi

exec python3 "$driver" scan __ARGS__ "${reports[@]}"
