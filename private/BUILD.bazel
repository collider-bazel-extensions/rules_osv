"""Private build files for rules_osv. Public surface lives in //:defs.bzl,
which re-exports from here."""

load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "osv.py",
    "run.sh.tmpl",
    "versions.bzl",
    "db_snapshots.bzl",
])

bzl_library(
    name = "providers",
    srcs = ["providers.bzl"],
)

bzl_library(
    name = "db",
    srcs = ["db.bzl"],
    deps = [":providers"],
)

bzl_library(
    name = "test",
    srcs = ["test.bzl"],
    deps = [":providers"],
)

bzl_library(
    name = "versions",
    srcs = ["versions.bzl"],
)

bzl_library(
    name = "db_snapshots",
    srcs = ["db_snapshots.bzl"],
)

bzl_library(
    name = "repositories",
    srcs = ["repositories.bzl"],
    deps = [":versions"],
)
