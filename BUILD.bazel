load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "MODULE.bazel",
    "defs.bzl",
    "extensions.bzl",
])

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = [
        "//private:db",
        "//private:providers",
        "//private:test",
    ],
)

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    deps = [
        "//private:db",
        "//private:db_snapshots",
        "//private:repositories",
        "//private:versions",
    ],
)
